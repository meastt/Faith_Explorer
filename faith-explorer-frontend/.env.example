# Faith Explorer Frontend Configuration
# Copy this file to .env and add your actual values

# Anthropic API Key (REQUIRED for AI features - used for Claude Haiku 3.5)
# Get your API key from: https://console.anthropic.com/
# This key is used for complex theological responses (explanations, comparisons, dialogue)
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Key (REQUIRED for cost-optimized AI features)
# Get your API key from: https://aistudio.google.com/apikey
# This key is used for simple operations (search keywords, JSON generation)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# RevenueCat Public API Key (for in-app purchases)
# Get your PUBLIC key from: https://app.revenuecat.com/ → Project Settings → API Keys
# IMPORTANT: Use the PUBLIC key (starts with "rcb_"), NOT the secret key!
VITE_REVENUECAT_PUBLIC_KEY=your_revenuecat_public_key_here
